# Copie este arquivo para `.env.production` (Vercel usa automaticamente)
# ou `.env.local` (Vite usa em dev) e preencha com a URL real da API.

# Em desenvolvimento (sem env var), o frontend usa http://localhost:8000
# Em produção, aponte pra URL pública da sua API (PythonAnywhere neste caso):
#   https://SEU_USUARIO.pythonanywhere.com
VITE_API_URL=http://localhost:8000
